  "typography": {
    "families": {
      "display": "'Big Shoulders Display', 'Arial Narrow', sans-serif",
      "body": "'Barlow', 'Segoe UI', sans-serif",
      "digits": "'Chivo Mono', ui-monospace, monospace"
    },
    "scale_px": {"xs": 12, "sm": 14, "md": 16, "lg": 20, "xl": 28, "xxl": 44, "hero": 64}
  },
  "spacing": {"scale_px": [4, 8, 12, 16, 24, 32, 48]},
