{
  "direction": "Station-service française : totems de prix à chiffres lumineux sur panneau sombre, posés sur un sol béton clair. L'accent (vert LED) est réservé aux prix.",
  "colors": {
    "ground":   {"light": "#eceeea", "dark": "#0e1110", "role": "fond de page (béton)"},
    "surface":  {"light": "#f9faf7", "dark": "#171b19", "role": "cartes, feuilles, champs"},
    "ink":      {"light": "#15181a", "dark": "#e8ebe6", "role": "texte principal"},
    "muted":    {"light": "#5d635f", "dark": "#8d948f", "role": "texte secondaire"},
    "line":     {"light": "#cfd3cc", "dark": "#2a302d", "role": "filets, bordures"},
    "panel":    {"light": "#111413", "dark": "#050706", "role": "plaque de totem (fond des prix)"},
    "accent":   {"light": "#5ff08c", "dark": "#63f392", "role": "chiffres LED des prix — seul accent"},
