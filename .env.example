# Copier vers .env.local (jamais commite).
# --- Application web / APK (cote navigateur : la cle "anon" est publique par conception) ---
VITE_SUPABASE_URL=https://VOTRE-REF-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=cle-anon-publique-de-votre-projet
# --- Scripts d'administration (scripts/sql.mjs, scripts/deploy-fn.mjs) : SECRETS ---
SUPABASE_PROJECT_REF=VOTRE-REF-PROJET
SUPABASE_ACCESS_TOKEN=jeton-d-acces-personnel-supabase
# --- Signature de l'APK (scripts/build-apk.sh) : SECRETS ---
ANDROID_HOME=/chemin/vers/android-sdk
JAVA_HOME=/chemin/vers/jdk-21
ANDROID_KEYSTORE_FILE=/chemin/vers/votre-cle.p12
ANDROID_KEYSTORE_PASSWORD=mot-de-passe-du-magasin
ANDROID_KEY_ALIAS=alias-de-la-cle
# --- Fonctions Supabase (a poser avec : supabase secrets set ...) ---
# SYNC_SECRET        secret partage avec les taches planifiees (aussi dans Vault : sync_prix_secret)
# RELAIS_BASE_URL    adresse de votre deploiement Vercel qui sert api/relais-es.js et api/relais-ro.js
